<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background Dark Glass Card -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#181824" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#2A2A3E" />
        </shape>
    </item>
    <!-- Mascot Icon -->
    <item
        android:width="20dp"
        android:height="20dp"
        android:left="16dp"
        android:top="16dp"
        android:drawable="@mipmap/launcher_icon" />
    <!-- Stop Button Squircle -->
    <item
        android:width="44dp"
        android:height="44dp"
        android:right="64dp"
        android:gravity="end|center_vertical"
        android:drawable="@drawable/widget_dark_button_background" />
    <!-- Play Button Squircle -->
    <item
        android:width="44dp"
        android:height="44dp"
        android:right="12dp"
        android:gravity="end|center_vertical"
        android:drawable="@drawable/widget_dark_button_background" />
</layer-list>
